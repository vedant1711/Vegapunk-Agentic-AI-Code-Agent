# ============================================================
# Vegapunk - Autonomous Coding Agent - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- NVIDIA NIM (Primary LLM) ---
# Get your free API key at: https://build.nvidia.com
# 1. Sign up / log in
# 2. Click any model → "Get API Key"
# 3. You get 1000 free inference credits
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google Gemini (Free Fallback LLM) ---
# Get your free API key at: https://aistudio.google.com/apikey
# 1. Sign in with Google account
# 2. Click "Create API Key"
# 3. Free tier: 15 RPM for Gemini 2.5 Pro, 30 RPM for Flash-Lite
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# --- GitHub ---
# Create a Personal Access Token (fine-grained):
# 1. Go to: https://github.com/settings/tokens?type=beta
# 2. Click "Generate new token"
# 3. Set permissions: Contents (Read+Write), Issues (Read+Write),
#    Pull Requests (Read+Write), Webhooks (Read)
# 4. Select the repositories you want the agent to access
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional: GitHub App credentials (for webhook verification)
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# --- Application Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./agentic_coder.db

# --- Docker Sandbox ---
SANDBOX_IMAGE=agentic-coder-sandbox:latest
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# Allow network egress from inside the sandbox container.
# TRUE (default): cloned projects can run "pip install" / "npm install"
# so their test suites actually work.
# FALSE: hardened isolation. Most real repos will regress because they
# can't install their deps.
SANDBOX_ALLOW_NETWORK=true

# --- Workspace ---
# Directory where the agent clones repos to work on them
WORKSPACE_DIR=./workspaces

# --- Best-of-N (Coder inference-time compute) ---
# K=1 disables Best-of-N (single LLM call, fastest, cheapest).
# K>=2 generates K candidate diffs in parallel and keeps the one that
# passes the most tests. Grounded in DeepSWE / ACECoder research on
# execution-verified rewards.
#
# COST WARNING: Coder cost scales linearly with K. On rate-limited free
# tiers (NIM signup credits, Gemini free 15 RPM), K=3 may trigger 429s.
# Lower to K=2 or K=1 if that happens.
CODER_BON_K=3
CODER_BON_TEMPERATURES_CSV=0.1,0.5,0.9
CODER_BON_MAX_PARALLEL=3
CODER_BON_TIMEOUT_SECONDS=180
